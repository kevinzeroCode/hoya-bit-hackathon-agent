# AWS authentication should use an AWS profile locally and an EC2 instance role in deployment.
# us-west-2 is the region S0/S8 actually verified Bedrock in, and the `us.` inference
# profiles the project uses are US-region only. Keep this pointed at us-west-2 even if
# the EC2 host itself lives elsewhere.
AWS_REGION=us-west-2
AWS_PROFILE=

# Verify both model IDs in the target account before the competition run.
BEDROCK_PRIMARY_MODEL_ID=
BEDROCK_FALLBACK_MODEL_ID=

# Optional research adapter. Leave empty to run with disclosed partial evidence.
CRYPTOPANIC_API_TOKEN=

ARTIFACT_ROOT=artifacts
LOG_LEVEL=INFO
