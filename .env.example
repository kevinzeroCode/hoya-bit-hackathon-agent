# AWS authentication should use an AWS profile locally and an EC2 instance role in deployment.
AWS_REGION=ap-northeast-1
AWS_PROFILE=

# Verify both model IDs in the target account before the competition run.
BEDROCK_PRIMARY_MODEL_ID=
BEDROCK_FALLBACK_MODEL_ID=

# Optional research adapter. Leave empty to run with disclosed partial evidence.
CRYPTOPANIC_API_TOKEN=

ARTIFACT_ROOT=artifacts
LOG_LEVEL=INFO

# Optional tuning. All non-secret; defaults apply when left empty.
# Unicode code points allowed in the stripped question (bounds 50..2000).
MAX_QUESTION_LENGTH=500
# Admissible fetched_at/published_at slack in seconds (bounds 0..300).
CLOCK_TOLERANCE_SECONDS=60
# Per-call model timeout in seconds; hard upper bound 45.
LLM_CALL_TIMEOUT_SECONDS=45
