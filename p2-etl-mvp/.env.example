# S0 preflight — 環境變數「名稱」範本（🚫 只列名,永不放真實值）
# 複製成 .env（.env 已被 gitignore）或直接在終端機 export / $env: 設定。
# 真實金鑰/token 絕不進 repo、log、artifact、UI、錄影。

# ── Amazon Bedrock（LLM 推理;正式目標）──────────────────────────
AWS_REGION=
BEDROCK_MODEL_ID=
BEDROCK_FALLBACK_MODEL_ID=
# 認證擇一：本機用 Bedrock API 金鑰;EC2 用 IAM 角色（instance profile,免設）
AWS_BEARER_TOKEN_BEDROCK=
# 或標準 AWS 臨時憑證：
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ── 資料 / artifact 路徑 ────────────────────────────────────────
HOYA_DATA_DIR=
ARTIFACT_ROOT=

# ── 研究來源（選用）────────────────────────────────────────────
CRYPTOPANIC_API_TOKEN=

# ── 本機開發用 LLM mock（選用;正式路徑是 Bedrock）─────────────
OPENAI_API_KEY=
